PORT=3001

# ---------------------------------------------------------------------------
# Base de datos
# ---------------------------------------------------------------------------
# Desarrollo local. Las rutas RELATIVAS se resuelven contra la carpeta backend/
# (no contra el directorio desde el que arrancas el proceso).
DATABASE_URL="file:./dev.db"

# Producción en Railway (con volumen montado en /data). Gana sobre DATABASE_URL.
# SQLITE_DB_PATH=/data/dev.db
# SQLITE_BACKUP_DIR=/data/backups

# ---------------------------------------------------------------------------
# CORS / seguridad HTTP
# ---------------------------------------------------------------------------
# Orígenes (esquema + host + puerto, sin ruta) del frontend que pueden llamar a la API desde un
# navegador. Lista separada por comas, p. ej.:
#   FRONTEND_URL=http://localhost:5173,https://pos.midominio.com
# - Desarrollo local: http://localhost:5173 (Vite). Si usas otro puerto, añádelo a la lista.
# - Producción con el frontend SERVIDO POR ESTE MISMO BACKEND (mismo dominio): no hace falta
#   definirla; sin FRONTEND_URL en producción solo se aceptan peticiones del mismo origen
#   (se avisa en el log al arrancar). Solo es necesaria si el frontend vive en OTRO dominio.
# - Sin FRONTEND_URL en desarrollo/pruebas: se permite localhost/127.0.0.1 con cualquier puerto.
FRONTEND_URL=http://localhost:5173

# Content-Security-Policy: por defecto se aplica. Si tras un despliegue algo del frontend se bloquea,
# pon CSP_REPORT_ONLY=true (el navegador avisa en consola pero no bloquea) mientras lo corriges.
# CSP_REPORT_ONLY=false

# ---------------------------------------------------------------------------
# Detrás de un proxy (Railway/Render)
# ---------------------------------------------------------------------------
# Número de proxies delante del backend. Por defecto: 1 con NODE_ENV=production, desactivado en
# desarrollo. Necesario para que el límite de tasa vea la IP real del cliente (X-Forwarded-For).
# Valores: número, false, o lista de IPs/subredes de confianza. NO uses "true" (permite falsear la IP).
# TRUST_PROXY=1

# ---------------------------------------------------------------------------
# Límites de tasa (por IP). Valores por defecto entre paréntesis.
# ---------------------------------------------------------------------------
# Login: intentos FALLIDOS por ventana (un login correcto no cuenta). Respuesta 429 + Retry-After.
# RATE_LIMIT_LOGIN_MAX=10
# RATE_LIMIT_LOGIN_WINDOW_MS=900000
# Global en /api (/health queda fuera). Holgado: todas las tablets de un local comparten IP.
# RATE_LIMIT_API_MAX=600
# RATE_LIMIT_API_WINDOW_MS=60000
# Interruptor de emergencia (también para pruebas de carga en local). No lo dejes activo en producción.
# RATE_LIMIT_DISABLED=true

# ---------------------------------------------------------------------------
# Usuario Admin inicial
# ---------------------------------------------------------------------------
# Contraseña con la que se crea el usuario "Admin" cuando NO existe (primer arranque).
# - En producción, si falta, se genera una contraseña ALEATORIA y se imprime UNA sola vez en el
#   log de arranque (guárdala; cámbiala después desde Usuarios).
# - Fuera de producción, si falta, se usa 123456 (solo para desarrollo/pruebas).
# Mínimo 6 caracteres. No se usa si el Admin ya existe.
# ADMIN_INITIAL_PASSWORD=
