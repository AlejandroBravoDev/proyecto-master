{
  "name": "sistema-restaurante",
  "productName": "Sistema Restaurante",
  "version": "1.1.0",
  "description": "Sistema POS y Gestión para Restaurantes",
  "main": "electron/dist/main.js",
  "scripts": {
    "db:generate": "cd backend && node ./node_modules/prisma/build/index.js generate",
    "build:backend": "cd backend && npm run build",
    "build:frontend": "cd frontend && npm run build",
    "build:electron": "node backend/node_modules/typescript/bin/tsc -p electron/tsconfig.json",
    "build": "npm run db:generate && npm run build:backend && npm run build:frontend && npm run build:electron",
    "start": "electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --win"
  },
  "keywords": [
    "restaurant",
    "pos",
    "electron",
    "react",
    "sqlite",
    "prisma"
  ],
  "author": "Alejandro",
  "license": "MIT",
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3"
  }
}
